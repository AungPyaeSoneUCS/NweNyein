# MongoDB Atlas (M0 Free Tier)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nwenyeinhill?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Initial Admin Seed (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@nwenyeinhill.org
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME=Administrator

# Google Drive API - choose ONE auth method

# Option 1 (recommended for personal Google accounts / My Drive): OAuth 2.0 user credentials
# Uploads use the folder owner's Drive quota (fixes "Service Accounts do not have storage quota").
# Create an OAuth 2.0 Client ID (Web/Desktop) in Google Cloud Console, enable Drive API,
# then obtain a refresh token for the Google account that owns the folders (scope: https://www.googleapis.com/auth/drive).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: redirect URI used by `npm run google:auth` (add it to your OAuth client)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3333/oauth2callback

# Option 2: Service Account (good for Shared Drives; My Drive uploads may fail with quota error)
# Share folders with the service account email (Editor for uploads). For Shared Drives, add it as a member.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Drive Folder IDs (Photos, Songs, Books folders in the owner's My Drive or a Shared Drive)
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=
GOOGLE_DRIVE_SONGS_FOLDER_ID=
GOOGLE_DRIVE_BOOKS_FOLDER_ID=
